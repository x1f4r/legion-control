.DS_Store
node_modules/

# Signing keys, keystores, and password files anywhere in the tree. They live outside the
# repository and must never be committed by accident.
*.jks
*.keystore
*.pw
*.idsig

# Staged release artifacts belong on GitHub releases, not in git history.
dist/

# Local build outputs and signing material.
**/bin/
*.key

# What cargo builds for the Rust workspace at the root of the repository.
/target/
