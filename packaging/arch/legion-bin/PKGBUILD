# Maintainer: x1f4r <106302360+x1f4r@users.noreply.github.com>
pkgname=legion-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Remote control node and CLI for managing machines (prebuilt static binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/x1f4r/legion-control'
license=('MIT')
depends=()
makedepends=('openssl')
optdepends=(
  'openssh: connect to and manage remote machines'
  'tailscale: discover peers and publish legion serve over a tailnet'
)
provides=('legion')
conflicts=('legion')
options=('!strip' '!debug')
source=(
  "legion-serve.service-${pkgver}::${url}/raw/legion-v${pkgver}/packaging/systemd/legion-serve.service"
  "legion.1-${pkgver}::${url}/raw/legion-v${pkgver}/packaging/man/legion.1"
  "LICENSE-${pkgver}::${url}/raw/legion-v${pkgver}/LICENSE"
  "SHA256SUMS-${pkgver}::${url}/releases/download/legion-v${pkgver}/SHA256SUMS"
  "SHA256SUMS.sig-${pkgver}::${url}/releases/download/legion-v${pkgver}/SHA256SUMS.sig"
  "legion-${pkgver}-${CARCH}-unknown-linux-musl::${url}/releases/download/legion-v${pkgver}/legion-${pkgver}-${CARCH}-unknown-linux-musl"
)
# Checksums are verified against the offline-signed SHA256SUMS in prepare() below.
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# Pinned Ed25519 public key from contract/release-public-key.pem (same key compiled into legion).
_release_pubkey='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAB8q1DNamFF0ShMi6Wzps/0UIGEkLmHDDvQqOvuv98zg=
-----END PUBLIC KEY-----'

prepare() {
  local asset="legion-${pkgver}-${CARCH}-unknown-linux-musl"
  local sums="${srcdir}/SHA256SUMS-${pkgver}"
  local sig_b64="${srcdir}/SHA256SUMS.sig-${pkgver}"
  local bin_path="${srcdir}/${asset}"
  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN

  local pub_pem="${tmpdir}/release-public-key.pem"
  local sig_raw="${tmpdir}/SHA256SUMS.sig.bin"
  printf '%s\n' "$_release_pubkey" > "$pub_pem"

  tr -d ' \t\r\n' < "$sig_b64" | base64 -d > "$sig_raw"
  local sig_len
  sig_len="$(wc -c < "$sig_raw" | tr -d '[:space:]')"
  if [[ "$sig_len" -ne 64 ]]; then
    printf 'legion-bin: SHA256SUMS.sig did not decode to a 64-byte Ed25519 signature\n' >&2
    return 1
  fi

  openssl pkeyutl -verify -pubin -inkey "$pub_pem" -rawin \
    -in "$sums" -sigfile "$sig_raw" >/dev/null

  local expected actual
  expected="$(awk -v name="$asset" '
    {
      sub(/\r$/, "")
      if ($0 == "" || substr($0, 1, 1) == "#") next
      hash = $1
      file = $2
      sub(/^\*/, "", file)
      if (file == name) {
        print tolower(hash)
        exit
      }
    }
  ' "$sums")"
  if [[ ! "$expected" =~ ^[0-9a-f]{64}$ ]]; then
    printf 'legion-bin: SHA256SUMS has no valid SHA-256 digest for %s\n' "$asset" >&2
    return 1
  fi

  actual="$(sha256sum "$bin_path" | awk '{print tolower($1)}')"
  if [[ "$actual" != "$expected" ]]; then
    printf 'legion-bin: checksum mismatch for %s (expected %s, got %s)\n' "$asset" "$expected" "$actual" >&2
    return 1
  fi
}

package() {
  install -Dm755 "${srcdir}/legion-${pkgver}-${CARCH}-unknown-linux-musl" "${pkgdir}/usr/bin/legion"
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/legion/managed-by" <<< 'pacman'
  install -Dm644 "${srcdir}/legion-serve.service-${pkgver}" "${pkgdir}/usr/lib/systemd/user/legion-serve.service"
  install -d "${pkgdir}/usr/share/man/man1"
  gzip -n -9 -c "${srcdir}/legion.1-${pkgver}" > "${pkgdir}/usr/share/man/man1/legion.1.gz"
  chmod 0644 "${pkgdir}/usr/share/man/man1/legion.1.gz"
  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
