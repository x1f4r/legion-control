# Maintainer: x1f4r <106302360+x1f4r@users.noreply.github.com>
pkgname=legion
pkgver=0.1.0
pkgrel=1
pkgdesc='Remote control node and CLI for managing machines'
arch=('x86_64' 'aarch64')
url='https://github.com/x1f4r/legion-control'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=(
  'openssh: connect to and manage remote machines'
  'tailscale: discover peers and publish legion serve over a tailnet'
)
options=('!debug' '!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/legion-v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/legion-control-legion-v${pkgver}"
  export CARGO_HOME="${CARGO_HOME:-${srcdir}/.cargo}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

  # Record the packaged commit for `legion --version` and `meta.version`: prefer an explicit
  # LEGION_BUILD_REV, then the 40-char commit stored in the GitHub tag archive's PAX global header,
  # and fall back to querying the tag commit remotely when git is available.
  local build_rev="${LEGION_BUILD_REV:-}"
  local tarball="${srcdir}/${pkgname}-${pkgver}.tar.gz"
  if [[ -z "$build_rev" && -f "$tarball" ]]; then
    build_rev="$({ gzip -dc "$tarball" 2>/dev/null || true; } | head -c 1024 | LC_ALL=C grep -aoE 'comment=[0-9a-f]{40}' | head -n 1 | cut -d= -f2 || true)"
  fi
  if [[ -z "$build_rev" ]] && command -v git >/dev/null 2>&1; then
    build_rev="$(git ls-remote "${url}.git" "refs/tags/legion-v${pkgver}^{}" "refs/tags/legion-v${pkgver}" 2>/dev/null | awk '
      /\^\{\}$/ { peeled = $1 }
      !/\^\{\}$/ && !plain { plain = $1 }
      END { print (peeled ? peeled : plain) }
    ' || true)"
  fi
  if [[ -n "$build_rev" ]]; then
    printf '%s\n' "$build_rev" > "${srcdir}/.legion-build-rev"
  fi
}

build() {
  cd "${srcdir}/legion-control-legion-v${pkgver}"
  export CARGO_HOME="${CARGO_HOME:-${srcdir}/.cargo}"
  export CARGO_TARGET_DIR="${srcdir}/target"

  if [[ -z "${LEGION_BUILD_REV:-}" && -s "${srcdir}/.legion-build-rev" ]]; then
    LEGION_BUILD_REV="$(<"${srcdir}/.legion-build-rev")"
    export LEGION_BUILD_REV
  elif [[ -z "${LEGION_BUILD_REV:-}" && -f "${srcdir}/${pkgname}-${pkgver}.tar.gz" ]]; then
    local pax_rev
    pax_rev="$({ gzip -dc "${srcdir}/${pkgname}-${pkgver}.tar.gz" 2>/dev/null || true; } | head -c 1024 | LC_ALL=C grep -aoE 'comment=[0-9a-f]{40}' | head -n 1 | cut -d= -f2 || true)"
    if [[ -n "$pax_rev" ]]; then
      export LEGION_BUILD_REV="$pax_rev"
    fi
  fi

  local remap_flags=""
  if [[ -n "${HOME:-}" ]]; then
    remap_flags+="--remap-path-prefix=${HOME}=/build/home "
  fi
  remap_flags+="--remap-path-prefix=${CARGO_HOME}=/cargo --remap-path-prefix=${srcdir}=/build"
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }${remap_flags}"

  cargo build --frozen --release -p legion-cli
}

package() {
  cd "${srcdir}/legion-control-legion-v${pkgver}"
  install -Dm755 "${srcdir}/target/release/legion" "${pkgdir}/usr/bin/legion"
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/legion/managed-by" <<< 'pacman'
  install -Dm644 packaging/systemd/legion-serve.service "${pkgdir}/usr/lib/systemd/user/legion-serve.service"
  install -Dm644 packaging/systemd/legion-sync.service "${pkgdir}/usr/lib/systemd/user/legion-sync.service"
  install -d "${pkgdir}/usr/share/man/man1"
  gzip -n -9 -c packaging/man/legion.1 > "${pkgdir}/usr/share/man/man1/legion.1.gz"
  chmod 0644 "${pkgdir}/usr/share/man/man1/legion.1.gz"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
