{
  "configVersion": 3,
  "system": { "id": "helper", "name": "Flat helper" },
  "updates": { "automatic": false, "pauseUntil": null, "maintenanceWindows": [] },
  "services": [],
  "boot": { "targets": {} },
  "actions": [
    {
      "id": "wake-tower",
      "name": "Wake the tower",
      "wol": {
        "mac": "02:00:00:00:00:01",
        "broadcast": ["192.168.50.255"],
        "ports": [9, 7],
        "repeats": 3
      }
    },
    {
      "id": "wake-laptop",
      "name": "Wake the attic laptop",
      "wol": {
        "mac": "02:00:00:00:00:02",
        "broadcast": ["192.168.50.255"]
      }
    }
  ]
}
