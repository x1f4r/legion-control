{
  "configVersion": 3,
  "system": { "id": "windows", "name": "Windows 11" },
  "updates": {
    "automatic": true,
    "pauseUntil": null,
    "maintenanceWindows": [{ "days": ["sat", "sun"], "from": "02:00", "to": "06:00" }]
  },
  "services": [
    {
      "id": "dashboard",
      "name": "Home Dashboard",
      "kind": "npm",
      "package": "@example/dashboard",
      "channel": "latest",
      "versionPattern": "^\\d+\\.\\d+\\.\\d+$",
      "process": { "type": "scheduled-task", "task": "Home Dashboard" },
      "health": { "type": "http", "port": 8080, "path": "/healthz" },
      "busy": { "type": "http", "port": 8080, "path": "/status", "busyWhen": "jobs.running" },
      "lockFile": "C:\\Users\\me\\.legion-control\\update.lock"
    },
    {
      "id": "stream",
      "name": "Stream Host",
      "kind": "command",
      "installedVersion": ["powershell", "-NoProfile", "-Command", "(Get-Item 'C:\\Program Files\\StreamHost\\stream.exe').VersionInfo.ProductVersion"],
      "process": {
        "type": "command",
        "start": ["powershell", "-NoProfile", "-Command", "Start-Service", "StreamHost"],
        "stop": ["powershell", "-NoProfile", "-Command", "Stop-Service", "StreamHost"],
        "running": ["powershell", "-NoProfile", "-Command", "if ((Get-Service StreamHost).Status -ne 'Running') { exit 1 }"]
      },
      "health": { "type": "http", "port": 47990, "path": "/" },
      "busy": { "type": "none" },
      "updates": { "automatic": false }
    }
  ],
  "boot": {
    "targets": {
      "linux": { "method": "clear-bootsequence", "name": "Linux" }
    }
  },
  "sleep": {
    "before": [],
    "settle": 2,
    "tools": ["C:\\Tools\\PSTools\\psshutdown64.exe"]
  },
  "actions": []
}
