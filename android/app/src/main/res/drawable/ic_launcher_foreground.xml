<!--
  The Legion, seen from the front, with the lid split between the two systems it dual boots: cool on
  the left for CachyOS, warm on the right for Windows. Everything sits inside the safe circle of the
  adaptive icon, so no part of the machine is cropped away by a launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lid -->
    <path
        android:fillColor="#D8E2EA"
        android:pathData="M34,35 L74,35 A3,3 0 0 1 77,38 L77,64 L31,64 L31,38 A3,3 0 0 1 34,35 Z" />

    <!-- Screen, one half per system -->
    <path
        android:fillColor="#3F8FC7"
        android:pathData="M34.5,38.5 L54,38.5 L54,60.5 L34.5,60.5 Z" />
    <path
        android:fillColor="#CC7A4C"
        android:pathData="M54,38.5 L73.5,38.5 L73.5,60.5 L54,60.5 Z" />

    <!-- Base -->
    <path
        android:fillColor="#EDF2F6"
        android:pathData="M26,66 L82,66 L84,71 A1.5,1.5 0 0 1 82.5,73 L25.5,73 A1.5,1.5 0 0 1 24,71 Z" />
</vector>
