<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ssh to the configured machines, and the wake-on-LAN broadcast. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing an update that this app downloaded itself. Android still shows its own
         confirmation, and the user has to allow this source once in settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reads the attached networks' link addresses. That is how the app knows whether it shares a
         subnet with a machine, which is the only place a wake-on-LAN broadcast can go. No location
         permission: the subnet of the interface answers the question without asking who the
         network is. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Saying how a change you asked for ended, when the app is not in front. Requested only when
         the setting is turned on, because a permission prompt for a feature nobody asked for is how
         people learn to refuse everything. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeping the app running while a change somebody asked for is still being sent or watched,
         so locking the phone does not freeze it halfway. Both are granted at install: there is
         nothing to ask. The second is the one Android 14 and later require for the dataSync type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The same service keeps the CPU running while it runs, screen off: a locked phone on battery
         otherwise suspends, and a wake's readiness polls or the pause before reading an operation
         again wait for the screen to come back. Granted at install too. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.x1f4r.legioncontrol.ui.LegionApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LegionControl">

        <activity
            android:name="com.x1f4r.legioncontrol.ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection"
            android:label="@string/app_name"
            android:theme="@style/Theme.LegionControl"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <!-- Does no work of its own. It runs only while a change is in flight, says so in a quiet
             notification, and stops itself when the last one settles. -->
        <service
            android:name="com.x1f4r.legioncontrol.ui.ChangeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The installer and explicit diagnostic sharing can read only their dedicated cache
             directories; application keys and private configuration are never exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
