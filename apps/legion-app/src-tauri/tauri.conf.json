{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legion",
  "identifier": "com.x1f4r.legion",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Legion",
        "width": 1080,
        "height": 740,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' tauri:; style-src 'self' tauri:; img-src 'self' tauri: data:; manifest-src 'self' tauri:; connect-src ipc: http://ipc.localhost https://ipc.localhost; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
