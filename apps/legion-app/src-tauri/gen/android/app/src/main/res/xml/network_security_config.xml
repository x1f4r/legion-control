<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny all cleartext network traffic by default; permit cleartext strictly for our local
         ephemeral loopback content server (127.0.0.1), which requires per-file 256-bit tickets
         and enforces strict Host/Origin/CSP headers. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
