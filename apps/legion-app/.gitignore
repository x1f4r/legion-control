# Staged static frontend copied from apps/ui by build.rs; keep the directory tracked via .gitkeep
# so tauri-cli finds frontendDist before build.rs runs on a clean checkout.
!dist/
dist/*
!dist/.gitkeep
# Cargo build outputs and build-time capability schemas for the standalone app workspace.
src-tauri/target/
src-tauri/gen/schemas/
# Local machine paths written by Gradle or Android Studio.
src-tauri/gen/android/local.properties
src-tauri/gen/android/.kotlin/
