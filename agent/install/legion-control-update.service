# One maintenance cycle. Driven by legion-control-update.timer, not enabled itself.
#
# This is a TEMPLATE. install-linux.sh fills in the placeholders and writes the
# result to the user's systemd unit directory.
#
# The agent decides everything: whether automatic updates are on, which services
# are eligible, whether a newer version exists, whether the machine is busy.
# This unit only provides a clean environment to run it in.
#
# It runs "cycle", not "update". "update" acts on ONE service — the first one —
# and does nothing else, so a machine with two services had one of them silently
# left behind. A cycle recovers operations an earlier run left unfinished, takes
# up anything queued for the next idle window, and then walks every eligible
# service. Those first two steps are the reason the timer matters even on a
# machine with nothing to update.

[Unit]
Description=Legion Control: run one update cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# A login shell is never sourced by systemd, so nothing about PATH can be
# assumed here. Spell it out, including the npm bin directory, so a service
# installed with npm can be found and driven.
Environment=PATH=@NPM_BIN@:/usr/local/bin:/usr/bin:/bin

# The update cycle drives services with "systemctl --user stop/start", which
# needs a session bus to talk to. When a unit is started by the timer there is
# no login session around to inherit these from, so pin them to the linger
# session for uid @UID@.
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus

ExecStart="@LAUNCHER@" cycle

# Worst case is several services, each with a cold package cache plus the 120 s
# health wait plus a rollback, so leave real headroom. A run killed here leaves
# operation records whose process is gone; the next cycle finds them, marks them
# interrupted and puts back any service that was left stopped.
TimeoutStartSec=1800

# The agent prints one JSON object to stdout, which lands in the journal.
# Read it back with: journalctl --user -u legion-control-update.service -n 50
StandardOutput=journal
StandardError=journal
