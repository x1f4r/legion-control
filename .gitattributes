# Keep JavaScript, shell, and PowerShell scripts on LF line endings across all platforms.
# A shell script with CRLF endings fails at its first line on Linux and macOS, and PowerShell reads
# LF as well as CRLF.
*.mjs text eol=lf
*.cjs text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
gradlew text eol=lf
# The Windows wrapper is stored and checked out with CRLF exactly as Gradle wrote it. It is marked
# as not text so git never tries to normalise it, which would show it as modified in every checkout.
gradlew.bat -text
