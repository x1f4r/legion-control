{
  "deviceName": "Desk tower",
  "self": {
    "machine": "tower",
    "system": "linux"
  },
  "localAgent": {
    "argv": [
      "node",
      "/home/me/.legion-control/agent/src/index.mjs"
    ]
  },
  "identityFile": "~/.ssh/legion-control_ed25519",
  "knownHostsFile": "~/.config/legion-control/known_hosts",
  "currentSite": "flat",
  "machines": {
    "legion": {
      "identityFile": "~/.ssh/id_legion",
      "sshAlias": "legion-windows-lan"
    },
    "pi": {
      "sshAlias": "beacon"
    }
  }
}
