{
  "$schema": "../schemas/identifiers-vectors.schema.json",
  "$comment": "Generated by node contract/tools/generate.mjs. Edit contract/tools, not these files.",
  "family": "identifiers",
  "contract": 3,
  "section": "1",
  "reference": "tools/identifiers.mjs",
  "notes": [
    "Each group pins one $defs entry of schemas/common.schema.json, and its name is that entry: token, configuredId, setupId, opId, duration, clockTime, sha256.",
    "Match the whole input with ASCII classes only, and refuse U+000A and U+000D before any pattern is applied: \\A...\\z in .NET and ICU, Regex.matches() in Kotlin, ^...$ with the u flag in JavaScript.",
    "Every value is a JSON string; the newline cases carry a real U+000A or U+000D, not a backslash and a letter."
  ],
  "groups": {
    "token": [
      {
        "name": "token-word",
        "purpose": "A plain word, the commonest argument a client sends.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": "demo"
        },
        "expect": {
          "valid": true
        }
      },
      {
        "name": "token-mixed-punctuation",
        "purpose": "Upper case, digits, underscore, dot and hyphen after the first character are all inside the grammar.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": "Demo_2.1-beta"
        },
        "expect": {
          "valid": true
        }
      },
      {
        "name": "token-colon",
        "purpose": "A colon after the first character is allowed; self-update operation targets look like this.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": "install:abc"
        },
        "expect": {
          "valid": true
        }
      },
      {
        "name": "token-windows-path",
        "purpose": "A colon and backslashes are both in the generic grammar, so a short Windows path is one token.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": "C:\\Users\\me"
        },
        "expect": {
          "valid": true
        }
      },
      {
        "name": "token-empty",
        "purpose": "The empty string is never a token: the grammar needs a leading letter or digit.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": ""
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-leading-dash",
        "purpose": "A leading hyphen reads as an option to whatever receives it, so the first character excludes it.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "shell-metacharacter"
        ],
        "input": {
          "value": "-demo"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-leading-dot",
        "purpose": "A leading dot is refused like a leading hyphen: the first character is a letter or digit only.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [],
        "input": {
          "value": ".demo"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-space",
        "purpose": "A space splits one argument into two in every shell, so it is outside the grammar.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "shell-metacharacter"
        ],
        "input": {
          "value": "de mo"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-semicolon",
        "purpose": "A semicolon ends a command in POSIX shells, so it never appears in a token.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "shell-metacharacter"
        ],
        "input": {
          "value": "demo;id"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-dollar",
        "purpose": "A dollar sign expands in POSIX shells and PowerShell, so it never appears in a token.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "shell-metacharacter"
        ],
        "input": {
          "value": "demo$x"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-non-ascii-letter",
        "purpose": "é is a letter to a Unicode-aware class such as \\w; the grammar is ASCII and refuses it.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "ascii"
        ],
        "input": {
          "value": "démo"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-trailing-lf",
        "purpose": "A trailing line feed. In .NET and ICU $ also matches before a final newline, so the input is refused before any pattern runs.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "newline"
        ],
        "input": {
          "value": "demo\n"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-trailing-crlf",
        "purpose": "A trailing CRLF, checked apart from the LF case because an implementation that strips one of the two lets the other through.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "newline"
        ],
        "input": {
          "value": "demo\r\n"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-line-separator",
        "purpose": "U+2028 is a line terminator to some engines and an ordinary character to others; it is simply not in the grammar.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "newline"
        ],
        "input": {
          "value": "demo\u2028"
        },
        "expect": {
          "valid": false
        }
      },
      {
        "name": "token-arabic-indic-digit",
        "purpose": "U+0663 ARABIC-INDIC DIGIT THREE matches \\d in .NET and Kotlin; the grammar means 0-9 and nothing else.",
        "consumers": [
          "agent",
          "mac",
          "desktop",
          "android"
        ],
        "tags": [
          "ascii"
        ],
        "input": {
          "value": "٣demo"
        },
        "expect": {
          "valid": false
        }
      }
    ],
