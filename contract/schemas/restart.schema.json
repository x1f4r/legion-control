{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "restart.schema.json",
  "title": "legionctl restart",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "$ref": "mutation.schema.json#/$defs/conflictRule"
    },
    {
      "$ref": "mutation.schema.json#/$defs/queueRule"
    },
    {
      "$ref": "mutation.schema.json#/$defs/acceptedRule"
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "restarted",
        "deferred",
        "queued",
        "failed",
        "accepted",
        "conflict",
        "interrupted",
        "cancelled",
        "expired",
        "already-running"
      ]
    },
    "service": {
      "$ref": "common.schema.json#/$defs/configuredId"
    },
    "op": {
      "$ref": "mutation.schema.json#/$defs/opOrNull"
    },
    "detached": {
      "type": "boolean"
    },
    "replayed": {
      "type": "boolean"
    },
    "replaced": {
      "$ref": "common.schema.json#/$defs/opIdOrNull"
    },
    "conflict": {
      "$ref": "common.schema.json#/$defs/opConflict"
    },
    "opId": {
      "description": "The operation id, echoed beside the record. Additive: the canonical place to read it is op.id.",
      "$ref": "common.schema.json#/$defs/opId"
    }
  },
  "required": [
    "action",
    "service",
    "op"
  ],
  "unevaluatedProperties": false
}
