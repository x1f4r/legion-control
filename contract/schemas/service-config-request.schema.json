{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-config-request.schema.json",
  "title": "Administrative service-config validate/set stdin",
  "type": "object",
  "properties": {
    "expectedHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "document": {
      "type": "object",
      "properties": {
        "configVersion": {
          "const": 3
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "configVersion",
        "services"
      ]
    }
  },
  "required": [
    "expectedHash",
    "document"
  ],
  "additionalProperties": false
}
