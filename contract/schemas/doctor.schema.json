{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctor.schema.json",
  "title": "legionctl doctor",
  "description": "Preflight and diagnosis. Every check that is not `ok` carries a fix in the imperative, because a diagnosis nobody can act on is just a complaint.",
  "type": "object",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "description": "`ok` is false exactly when some check failed. A warning is not a failure.",
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "properties": { "counts": { "properties": { "fail": { "const": 0 } } } } }
    }
  ],
  "properties": {
    "deep": { "type": "boolean" },
    "checks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/doctorCheck" }, "minItems": 1, "maxItems": 200 },
    "counts": {
      "type": "object",
      "properties": {
        "ok": { "$ref": "common.schema.json#/$defs/count" },
        "warn": { "$ref": "common.schema.json#/$defs/count" },
        "fail": { "$ref": "common.schema.json#/$defs/count" }
      },
      "required": ["ok", "warn", "fail"],
      "additionalProperties": false
    },
    "elapsedMs": { "$ref": "common.schema.json#/$defs/millis" }
  },
  "required": ["deep", "checks", "counts", "elapsedMs"],
  "unevaluatedProperties": false
}
