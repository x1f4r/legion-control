        "unknown",
        "reason",
        "monitoredServices",
        "unmonitoredServices"
      ]
    },
    "serviceUpdatesFields": {
      "type": "object",
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "inherited": {
          "type": "boolean"
        },
        "pauseUntil": {
          "$ref": "#/$defs/isoOrNull"
        },
        "maintenanceWindows": {
          "$ref": "#/$defs/maintenanceWindowsOrNull"
        },
        "eligibleNow": {
          "type": "boolean"
        },
        "deferredReason": {
          "$ref": "#/$defs/reasonCodeOrNull"
        },
        "order": {
          "description": "Optional ordering hint for the scheduled cycle. Lower runs first; the default 0 leaves the configured order. Clients may ignore it.",
          "type": "integer"
        },
        "after": {
          "description": "Optional service ids this one is walked after within a cycle. Clients may ignore it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "automatic",
        "inherited",
        "pauseUntil",
        "eligibleNow",
        "deferredReason"
      ]
    },
    "lineage": {
      "description": "Hashes of the ancestors of a controller document, newest first: the canonical hash of the parent, then its parent, and so on. This is what makes concurrent edits detectable. A revision number only orders documents that came from one writer; with several peers editing offline, two documents can carry revision 6 and neither descend from the other, and nothing but ancestry can tell that apart from one of them simply being newer. Capped at 32, which means two branches more than 32 revisions apart are reported as divergence rather than as one being behind. That fails toward a question, never toward a loss.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/sha256"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "configuredId": {
      "description": "Agent-configured service, action or boot target identifier; matches config.mjs ID_PATTERN.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "setupId": {
      "description": "Shared setup identity; matches controller.mjs SETUP_ID_PATTERN, not the generic argv grammar.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "configuredIdOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/configuredId"
        },
        {
          "type": "null"
        }
      ]
    },
    "setupIdOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/setupId"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
