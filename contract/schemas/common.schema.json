    "busyFields": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "unknown": {
          "type": "boolean"
        },
        "monitored": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/busyEvidence"
        },
        "checkedAt": {
          "$ref": "#/$defs/iso"
        },
        "elapsedMs": {
          "$ref": "#/$defs/millis"
        },
        "error": {
          "$ref": "#/$defs/textOrNull"
        },
        "runningTurns": {
          "$ref": "#/$defs/count"
        },
        "pendingTurns": {
          "$ref": "#/$defs/count"
        },
        "pendingApprovals": {
          "$ref": "#/$defs/count"
        },
        "staleTurns": {
          "$ref": "#/$defs/count"
        },
        "staleApprovals": {
          "$ref": "#/$defs/count"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/busyThread"
          },
          "maxItems": 50
        },
        "threadsTruncated": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "busy",
        "unknown",
        "monitored",
        "reason",
        "evidence",
        "checkedAt",
        "elapsedMs",
        "error"
      ],
      "allOf": [
        {
          "description": "A service nobody described a busy probe for blocks, and says so as all three of monitored false, unknown true and busy true. Only the evidence names it; a client that renders \"not monitored\" reads that, never the reason string.",
          "if": {
            "properties": {
              "evidence": {
                "const": "unmonitored"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "properties": {
              "monitored": {
                "const": false
              },
              "unknown": {
                "const": true
              },
              "busy": {
                "const": true
              }
            }
          }
        },
        {
          "description": "Busy type \"none\" is a declaration that there is nothing here to protect. It is an answer, not the absence of one, so it counts as monitored: status.busy.unmonitoredServices is the number of services that block for want of a probe, and a client renders that count as something to fix.",
          "if": {
            "properties": {
              "evidence": {
                "const": "none"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "properties": {
              "monitored": {
                "const": true
              },
              "unknown": {
                "const": false
              },
              "busy": {
                "const": false
              }
            }
          }
        },
        {
          "description": "Fail closed, everywhere: a reading that could not be taken blocks. There is no state in which the gate does not know and lets the work through.",
          "if": {
            "properties": {
              "unknown": {
                "const": true
              }
            },
            "required": [
              "unknown"
            ]
          },
          "then": {
            "properties": {
              "busy": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "busyAggregateFields": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "unknown": {
          "type": "boolean"
        },
        "reason": {
