{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for the Legion Control agent contract, version 3",
  "description": "Nothing validates against this file directly. Every reply schema refs into it, so a type is written once and every command agrees about it.",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.+-]+)?$"
    },
    "iso": {
      "type": "string",
      "description": "ISO 8601 with an explicit zone. The agent always writes UTC with milliseconds; clients must accept any offset.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "isoOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/iso"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256OrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "token": {
      "description": "Generic non-path command argument grammar. Semantic identifiers have narrower definitions; interpreter/script/path arguments use the configured shell quoting rules.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/\\\\~=+-]*$"
    },
    "tokenOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "opId": {
      "description": "A lowercase UUIDv4, or any lowercase id of 8 to 64 characters from [a-z0-9-].",
      "type": "string",
      "pattern": "^[a-z0-9-]{8,64}$"
    },
    "opIdOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/opId"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(m|h|d)$"
    },
    "clockTime": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "portOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/port"
        },
        {
          "type": "null"
        }
      ]
    },
    "millis": {
      "type": "integer",
      "minimum": 0
    },
    "millisOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/millis"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "textOrNull": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "description": "The closed enum from v3.md section 2.2. Codes may be added in a later 3.x; a client that meets one it does not know renders the message and treats the reply as failed.",
      "enum": [
        "busy",
        "busy-unknown",
        "policy-off",
        "policy-paused",
        "outside-window",
        "operation-in-progress",
        "lock-held",
        "no-update",
        "latest-unknown",
        "not-installed",
        "not-running",
        "app-closed",
        "apply-attempts-exhausted",
        "apply-failed",
        "postcondition-failed",
        "rolled-back",
        "not-configured",
        "unsupported-platform",
        "unknown-service",
        "unknown-target",
        "unknown-action",
        "bad-argument",
        "config-invalid",
        "config-missing",
        "interrupted",
        "expired",
        "cancelled",
        "already-running",
        "already-on-target",
        "stale-revision",
        "controller-conflict",
        "signature-invalid",
        "restricted",
        "timed-out",
        "internal"
      ]
    },
    "reasonCodeOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/reasonCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "systemIdentity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "notes": {
      "description": "Warnings worth showing, in the agent's own words. Rendered as written.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "maxItems": 50
    },
    "envelope": {
      "description": "On every reply from a 3.x agent, whatever the command and whatever went wrong.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "contract": {
          "const": 3
        },
        "agentVersion": {
          "$ref": "#/$defs/semver"
        },
        "system": {
          "$ref": "#/$defs/systemIdentity"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCode"
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "ok",
        "contract",
        "agentVersion",
        "system"
      ]
    },
    "busyEvidence": {
      "description": "What the busy answer was read from. `unmonitored` is a service with no busy key at all; `none` is a service that declared it is never busy.",
      "enum": [
        "t3-sqlite",
        "command",
        "http",
        "none",
        "unmonitored",
        "probe-error",
        "timed-out"
      ]
    },
    "busyThread": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/textOrNull"
        },
        "turnId": {
          "$ref": "#/$defs/textOrNull"
        },
        "title": {
          "$ref": "#/$defs/textOrNull"
        },
        "state": {
          "$ref": "#/$defs/text"
        },
        "at": {
          "$ref": "#/$defs/isoOrNull"
        },
        "blocking": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "running",
            "pending",
            "pending-approval",
            "stale"
          ]
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "threadId",
        "turnId",
        "title",
        "state",
        "at",
        "blocking",
        "disposition",
        "stale"
      ],
      "additionalProperties": false
    },
    "busy": {
      "description": "One service's busy state. `busy` and `unknown` are the two 2.x keys and keep their meaning; `unknown` true means the probe could not be read and the gate fails closed.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/busyFields"
        }
      ],
      "unevaluatedProperties": false
    },
    "busyAggregate": {
      "description": "The machine-wide answer. `busy` here is true when any service blocks, and unknown counts as blocking.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/busyAggregateFields"
        }
      ],
      "unevaluatedProperties": false
    },
    "relay": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        }
      },
      "required": [
        "configured",
        "running"
      ],
      "additionalProperties": false
    },
    "lastUpdate": {
      "description": "The 2.x record of the last update of one service. Kept for 2.x clients; a 3.x client reads `lastOperation` and the ops records instead.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "$ref": "#/$defs/iso"
            },
            "from": {
              "$ref": "#/$defs/version"
            },
            "to": {
              "$ref": "#/$defs/version"
            },
            "result": {
              "$ref": "#/$defs/text"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "at",
            "from",
            "to",
            "result",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "maintenanceWindow": {
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weekday"
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "from": {
          "$ref": "#/$defs/clockTime"
        },
        "to": {
          "$ref": "#/$defs/clockTime"
        }
      },
      "required": [
        "days",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "maintenanceWindows": {
      "description": "Local time on the machine. An empty list means any time. `from` later than `to` is an overnight window.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/maintenanceWindow"
      },
      "maxItems": 14
    },
    "maintenanceWindowsOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/maintenanceWindows"
        },
        {
          "type": "null"
        }
      ]
    },
    "systemUpdates": {
      "description": "The effective machine-wide update policy, as `status` and `policy` report it.",
      "type": "object",
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "pauseUntil": {
          "$ref": "#/$defs/isoOrNull"
        },
        "maintenanceWindows": {
          "$ref": "#/$defs/maintenanceWindows"
        },
        "inWindowNow": {
          "type": "boolean"
        },
        "nextWindow": {
          "$ref": "#/$defs/isoOrNull"
        },
        "lastCycle": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "opId": {
                  "$ref": "#/$defs/opId"
                },
                "at": {
                  "$ref": "#/$defs/iso"
                },
                "action": {
                  "$ref": "#/$defs/opAction"
                }
              },
              "required": [
                "opId",
                "at",
                "action"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "automatic",
        "pauseUntil",
        "maintenanceWindows",
        "inWindowNow",
        "nextWindow",
        "lastCycle"
      ],
      "additionalProperties": false
    },
    "serviceUpdates": {
      "description": "One service's effective policy. `inherited` is true when the service sets none of its own and takes the machine's.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/serviceUpdatesFields"
        }
      ],
      "unevaluatedProperties": false
    },
    "opKind": {
      "enum": [
        "update",
        "restart",
        "boot",
        "sleep",
        "run",
        "cycle",
        "self-update"
      ]
    },
    "opMode": {
      "enum": [
        "scheduled",
        "manual",
        "force",
        "queued"
      ]
    },
    "opState": {
      "enum": [
        "queued",
        "running",
        "finished"
      ]
    },
    "opPhase": {
      "description": "The union of the per-kind phase lists in v3.md section 2.3. Which phases a kind may report is fixed there; the union is what a decoder has to accept.",
      "enum": [
        "resolving",
        "recovering",
        "checking-busy",
        "warming",
        "locking",
        "stopping",
        "installing",
        "verifying",
        "starting",
        "health",
        "rolling-back",
        "restarting",
        "arming",
        "rebooting",
        "preparing",
        "suspending",
        "running",
        "queued",
        "services",
        "staging",
        "self-test",
        "swapping",
        "done"
      ]
    },
    "opAction": {
      "description": "The union of the per-kind result actions. Section 2.3 lists which of these each kind may produce.",
      "enum": [
        "accepted",
        "already-running",
        "armed",
        "cancelled",
        "checked",
        "conflict",
        "cycled",
        "deferred",
        "expired",
        "failed",
        "installed",
        "interrupted",
        "noop",
        "queued",
        "ran",
        "rebooted",
        "rebooting",
        "restarted",
        "rolled-back",
        "skipped",
        "slept",
        "sleeping",
        "updated"
      ]
    },
    "opActionOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/opAction"
        },
        {
          "type": "null"
        }
      ]
    },
    "opInitiator": {
      "description": "Who asked. `client` comes from LEGIONCTL_CLIENT, which the restricted dispatcher sets from the authorized_keys comment; a local shell is \"cli\".",
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/$defs/text"
        },
        "device": {
          "$ref": "#/$defs/textOrNull"
        },
        "user": {
          "$ref": "#/$defs/textOrNull"
        }
      },
      "required": [
        "client",
        "device",
        "user"
      ],
      "additionalProperties": false
    },
    "opProgress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "of": {
              "type": "integer",
              "minimum": 1
            },
            "note": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "step",
            "of",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "opResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "action": {
              "$ref": "#/$defs/opAction"
            },
            "reasonCode": {
              "$ref": "#/$defs/reasonCodeOrNull"
            },
            "message": {
              "$ref": "#/$defs/text"
            },
            "from": {
              "$ref": "#/$defs/version"
            },
            "to": {
              "$ref": "#/$defs/version"
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verified": {
              "type": "boolean"
            }
          },
          "required": [
            "ok",
            "action",
            "reasonCode",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "opLogEntry": {
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/iso"
        },
        "line": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "line"
      ],
      "additionalProperties": false
    },
    "opChild": {
      "description": "One service's outcome inside a cycle.",
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/opId"
        },
        "service": {
          "$ref": "#/$defs/configuredId"
        },
        "action": {
          "$ref": "#/$defs/opAction"
        },
        "reasonCode": {
          "$ref": "#/$defs/reasonCodeOrNull"
        }
      },
      "required": [
        "opId",
        "service",
        "action",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "opRecord": {
      "description": "One operation, exactly as it is stored at <base>/ops/<id>.json and exactly as `op` returns it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/opId"
        },
        "kind": {
          "$ref": "#/$defs/opKind"
        },
        "service": {
          "$ref": "#/$defs/configuredIdOrNull"
        },
        "target": {
          "$ref": "#/$defs/tokenOrNull"
        },
        "actionId": {
          "$ref": "#/$defs/configuredIdOrNull"
        },
        "mode": {
          "$ref": "#/$defs/opMode"
        },
        "initiator": {
          "$ref": "#/$defs/opInitiator"
        },
        "state": {
          "$ref": "#/$defs/opState"
        },
        "phase": {
          "$ref": "#/$defs/opPhase"
        },
        "progress": {
          "$ref": "#/$defs/opProgress"
        },
        "requestedAt": {
          "$ref": "#/$defs/iso"
        },
        "startedAt": {
          "$ref": "#/$defs/isoOrNull"
        },
        "updatedAt": {
          "$ref": "#/$defs/iso"
        },
        "finishedAt": {
          "$ref": "#/$defs/isoOrNull"
        },
        "expiresAt": {
          "$ref": "#/$defs/isoOrNull"
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "from": {
          "$ref": "#/$defs/version"
        },
        "to": {
          "$ref": "#/$defs/version"
        },
        "result": {
          "$ref": "#/$defs/opResult"
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opLogEntry"
          },
          "maxItems": 200
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opChild"
          },
          "maxItems": 50
        },
        "replaced": {
          "$ref": "#/$defs/opIdOrNull"
        },
        "agentVersion": {
          "$ref": "#/$defs/semver"
        },
        "systemId": {
          "$ref": "#/$defs/token"
        }
      },
      "required": [
        "id",
        "kind",
        "service",
        "target",
        "actionId",
        "mode",
        "initiator",
        "state",
        "phase",
        "progress",
        "requestedAt",
        "startedAt",
        "updatedAt",
        "finishedAt",
        "expiresAt",
        "pid",
        "detached",
        "result",
        "log",
        "agentVersion",
        "systemId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A finished operation has an end and a result; a running or queued one has neither.",
          "if": {
            "properties": {
              "state": {
                "const": "finished"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "finishedAt": {
                "$ref": "#/$defs/iso"
              },
              "result": {
                "type": "object",
                "properties": {
                  "ok": {},
                  "action": {},
                  "reasonCode": {},
                  "message": {},
                  "from": {},
                  "to": {},
                  "exitCode": {},
                  "output": {},
                  "verified": {}
                }
              },
              "phase": {
                "const": "done"
              },
              "pid": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "finishedAt": {
                "type": "null"
              },
              "result": {
                "type": "null"
              }
            }
          }
        },
        {
          "description": "A queued operation has an expiry and no pid; nothing else does.",
          "if": {
            "properties": {
              "state": {
                "const": "queued"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "expiresAt": {
                "$ref": "#/$defs/iso"
              },
              "pid": {
                "type": "null"
              },
              "startedAt": {
                "type": "null"
              },
              "phase": {
                "const": "queued"
              }
            }
          }
        },
        {
          "description": "Boot names a configured target; self-update names its immutable install or rollback identity. Other operation kinds leave target null.",
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "boot",
                  "self-update"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/token"
              },
              "service": {
                "type": "null"
              },
              "actionId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "run"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "actionId": {
                "$ref": "#/$defs/token"
              },
              "service": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "actionId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cycle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "service": {
                "type": "null"
              },
              "children": {
                "type": "array"
              }
            },
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "self-update"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^(install|rollback):[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "opSummary": {
      "description": "The short form of an operation, used by `status.operations` and by `history`. Every field is drawn from the record of the same name.",
