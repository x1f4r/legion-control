    "doctorCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:config\\.(?:parse|validate)|base\\.writable|node\\.(?:version|sqlite)|npm\\.(?:available|prefix)|service\\.[A-Za-z0-9][A-Za-z0-9._-]*\\.(?:process|health|busy|relay|latest|endpoint)|scheduler\\.(?:present|command|lastRun)|privileges\\.(?:sudo|boot)|sleep\\.tool|locks|ops\\.dir|controller\\.copy|session\\.restricted|clock)$"
        },
