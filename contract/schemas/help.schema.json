{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "help.schema.json",
  "title": "legionctl help",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "properties": {
    "usage": { "$ref": "common.schema.json#/$defs/text" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/token" },
          "flags": { "type": "array", "items": { "type": "string", "minLength": 2 }, "maxItems": 20 },
          "mutates": { "type": "boolean" },
          "summary": { "$ref": "common.schema.json#/$defs/text" }
        },
        "required": ["name", "flags", "mutates", "summary"],
        "additionalProperties": false
      }
    },
    "error": { "$ref": "common.schema.json#/$defs/text" }
  },
  "required": ["usage", "commands"],
  "unevaluatedProperties": false
}
