{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-vectors.schema.json",
  "title": "contract/vectors/launch.json",
  "description": "Launch values and local approval, v3.md section 9.9, as cases. review gives a held document, this device's record of approved launch values and a descendant of the held document, and expects what waits for review, what the device runs meanwhile, and whether agent 3.1.0 refuses the descendant from a restricted session. migration pins the one change accepted without asking.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "family": { "const": "launch" },
    "contract": { "const": 3 },
    "section": { "const": "9.9" },
    "reference": { "const": "tools/launch.mjs" },
    "notes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "groups": {
      "type": "object",
      "properties": {
        "review": { "type": "array", "minItems": 33, "items": { "$ref": "#/$defs/reviewCase" } },
        "migration": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/migrationCase" } }
      },
      "required": ["review", "migration"],
      "additionalProperties": false
    }
  },
  "required": ["family", "contract", "section", "reference", "notes", "groups"],
  "additionalProperties": false,
  "$defs": {
    "scope": { "enum": ["system", "identityFile", "repo", "local"] },
    "tuple": {
      "description": "A system's launch value. A null agent is inert: nothing runs on the system.",
      "type": "object",
      "properties": {
        "agent": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "grammar": { "type": ["string", "null"] }
      },
      "required": ["agent", "grammar"],
      "additionalProperties": false
    },
    "record": {
      "description": "One device's record of approved launch values (v3.md section 11). Informative: it has no schema of its own, and here it is only an input.",
      "type": "object",
      "properties": {
        "schema": { "const": 1 },
        "seededFrom": { "type": "string" }
      },
      "required": ["schema", "seededFrom"]
    },
    "reviewCase": {
      "type": "object",
      "properties": {
        "name": { "$ref": "vector-index.schema.json#/$defs/caseName" },
        "purpose": { "$ref": "vector-index.schema.json#/$defs/purpose" },
        "consumers": { "$ref": "vector-index.schema.json#/$defs/consumers" },
        "tags": { "$ref": "vector-index.schema.json#/$defs/tags" },
        "input": {
          "type": "object",
          "properties": {
            "heldText": { "type": ["string", "null"] },
            "approvals": { "anyOf": [{ "$ref": "#/$defs/record" }, { "type": "null" }] },
            "offeredText": { "type": "string" }
          },
          "required": ["heldText", "approvals", "offeredText"],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "review": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "$ref": "common.schema.json#/$defs/launchPath" },
                  "scope": { "$ref": "#/$defs/scope" },
                  "kind": { "enum": ["changed", "new"] },
                  "approvable": { "type": "boolean" }
                },
                "required": ["path", "scope", "kind", "approvable"],
                "additionalProperties": false
              }
            },
            "effective": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "$ref": "common.schema.json#/$defs/launchPath" },
                  "scope": { "$ref": "#/$defs/scope" },
                  "state": { "enum": ["offered", "approved", "not-driven", "built-in", "none"] },
                  "agent": { "anyOf": [{ "type": "array", "minItems": 1, "items": { "type": "string" } }, { "type": "null" }] },
                  "grammar": { "enum": ["posix", "dispatch", "cmd", "powershell", null] },
                  "text": { "type": ["string", "null"] }
                },
                "required": ["path", "scope", "state", "agent", "grammar", "text"],
                "additionalProperties": false
              }
            },
            "restrictedRefused": { "type": "boolean" }
          },
          "required": ["review", "effective", "restrictedRefused"],
          "additionalProperties": false
        }
      },
      "required": ["name", "purpose", "consumers", "tags", "input", "expect"],
      "additionalProperties": false
    },
    "migrationCase": {
      "type": "object",
      "properties": {
        "name": { "$ref": "vector-index.schema.json#/$defs/caseName" },
        "purpose": { "$ref": "vector-index.schema.json#/$defs/purpose" },
        "consumers": { "$ref": "vector-index.schema.json#/$defs/consumers" },
        "tags": { "$ref": "vector-index.schema.json#/$defs/tags" },
        "input": {
          "type": "object",
          "properties": {
            "approved": { "$ref": "#/$defs/tuple" },
            "offered": { "$ref": "#/$defs/tuple" }
          },
          "required": ["approved", "offered"],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": { "migration": { "type": "boolean" } },
          "required": ["migration"],
          "additionalProperties": false
        }
      },
      "required": ["name", "purpose", "consumers", "tags", "input", "expect"],
      "additionalProperties": false
    }
  }
}
